// =============================================
// Část B – Stříbro, doplnění roku 2009 (I-1)
// Senzor: Landsat 5
// Indexy: NDVI, BSI, LST
// =============================================

var lokality = ee.FeatureCollection(
  'projects/diplomka-fv-2018/assets/lokality_fve_all');

var fve = lokality
  .filter(ee.Filter.eq('site_id', 'stribro'))
  .filter(ee.Filter.eq('type', 'FVE_buffer'))
  .geometry();

var obdobi = [
  ['2009-03', '2009-03-01', '2009-03-31'],
  ['2009-04', '2009-04-01', '2009-04-30'],
  ['2009-05', '2009-05-01', '2009-05-31'],
  ['2009-06', '2009-06-01', '2009-06-30'],
  ['2009-07', '2009-07-01', '2009-07-31'],
  ['2009-08', '2009-08-01', '2009-08-31'],
  ['2009-09', '2009-09-01', '2009-09-30'],
  ['2009-10', '2009-10-01', '2009-10-31'],
];

function getIndices(startDate, endDate, geometry) {
  var landsat = ee.ImageCollection('LANDSAT/LT05/C02/T1_L2')
    .merge(ee.ImageCollection('LANDSAT/LE07/C02/T1_L2'))
    .filterBounds(geometry)
    .filterDate(startDate, endDate)
    .filter(ee.Filter.lt('CLOUD_COVER', 70))
    .select(['SR_B3', 'SR_B4', 'SR_B5', 'SR_B1', 'ST_B6']);

  var calcIndices = function(image) {
    var ndvi = image.normalizedDifference(['SR_B4', 'SR_B3']).rename('NDVI');
    var bsi = image.expression(
      '(SWIR + RED - NIR - BLUE) / (SWIR + RED + NIR + BLUE)',
      {
        'SWIR': image.select('SR_B5'),
        'RED':  image.select('SR_B3'),
        'NIR':  image.select('SR_B4'),
        'BLUE': image.select('SR_B1')
      }
    ).rename('BSI');
    var bt = image.select('ST_B6')
                  .multiply(0.00341802)
                  .add(149.0)
                  .subtract(273.15);
    var pv = ndvi.subtract(ee.Number(0.2))
                 .divide(ee.Number(0.6))
                 .pow(2).rename('pv');
    var emissivity = pv.multiply(0.004).add(0.986).rename('em');
    var lst = bt.expression(
      'BT / (1 + (0.00115 * BT / 1.438) * log(em))',
      {'BT': bt, 'em': emissivity}
    ).rename('LST');
    return ndvi.addBands(bsi).addBands(lst);
  };

  var median = landsat.map(calcIndices).median();

  var result = ee.Algorithms.If(
    landsat.size().gt(0),
    median.reduceRegion({
      reducer: ee.Reducer.mean(),
      geometry: geometry,
      scale: 30
    }),
    ee.Dictionary({'NDVI': null, 'BSI': null, 'LST': null})
  );

  return result;
}

var allFeatures = [];

obdobi.forEach(function(o) {
  var label = o[0];
  var start = o[1];
  var end   = o[2];

  var indices = ee.Dictionary(getIndices(start, end, fve));

  allFeatures.push(ee.Feature(null, {
    'site_id': 'stribro',
    'Obdobi':  label,
    'NDVI':    indices.get('NDVI'),
    'BSI':     indices.get('BSI'),
    'LST':     indices.get('LST')
  }));
});

var tabulka = ee.FeatureCollection(allFeatures);

Export.table.toDrive({
  collection: tabulka,
  description: 'PartB_stribro_2009',
  folder: 'Diplomka',
  fileNamePrefix: 'PartB_stribro_2009',
  fileFormat: 'CSV'
});
