// Funkce pro výpočet průměrné LST za dané období
function getLST(startDate, endDate, geometry) {
  
  var landsat = ee.ImageCollection('LANDSAT/LC08/C02/T1_L2')
    .merge(ee.ImageCollection('LANDSAT/LC09/C02/T1_L2'))
    .filterBounds(geometry)
    .filterDate(startDate, endDate)
    .filter(ee.Filter.lt('CLOUD_COVER', 50));
  
  // Funkce pro výpočet LST z jednoho snímku
  var calcLST = function(image) {
    
    // Krok 1: Jasová teplota z ST_B10 (scale factor)
    var bt = image.select('ST_B10')
                  .multiply(0.00341802)
                  .add(149.0)
                  .subtract(273.15); // Kelvin → Celsius
    
    // Krok 2: NDVI pro odhad emitivity
    var ndvi = image.normalizedDifference(['SR_B5', 'SR_B4']);
    
    // Krok 3: Emitivita z NDVI
    var ndviMin = ee.Number(0.2);
    var ndviMax = ee.Number(0.8);
    var pv = ndvi.subtract(ndviMin)
                 .divide(ndviMax.subtract(ndviMin))
                 .pow(2)
                 .rename('pv');
    var emissivity = pv.multiply(0.004).add(0.986).rename('em');
    
    // Krok 4: LST z jasové teploty a emitivity
    var lst = bt.expression(
      'BT / (1 + (0.00115 * BT / 1.438) * log(em))',
      {'BT': bt, 'em': emissivity}
    ).rename('LST');
   
    return lst;
  };
  
  // Medián LST za období
  var lstCollection = landsat.map(calcLST);
  var lstMedian = lstCollection.median();
  
  // Kontrola prázdné kolekce
  var lstMean = ee.Algorithms.If(
    landsat.size().gt(0),
    lstMedian.reduceRegion({
      reducer: ee.Reducer.mean(),
      geometry: geometry,
      scale: 30
    }).get('LST'),
    null
  );
  
  return lstMean;
}
